    // ┃    ESC    ┃ █████████ ┃           ┃     <     ┃     >     ┃     /     ┃   ┃     _     ┃     {     ┃     }     ┃     +     ┃     !     ┃   BSPC    ┃
    // ┗━━━━━━━━━━━┗━━━━━━━━━━━┻━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┻━━━━━━━━━━━┛━━━━━━━━━━━┛
    //                                     ┃           ┃ SPACE/NAV ┃ MAGISHIFT ┃   ┃           ┃           ┃           ┃
