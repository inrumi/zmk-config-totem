    //                                     ┃           ┃ SPACE/NAV ┃ MAGISHIFT ┃   ┃           ┃           ┃           ┃
    //                                     ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛   ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛
     bindings = <
    // ╷           ╷           ╷           ╷           ╷           ╷           ╷   ╷           ╷           ╷           ╷           ╷           ╷           ╷
                 &studio_unlock &kp C_PREV  &kp C_PP    &kp C_NEXT  &kp C_VOL_UP    ___         ___         ___         ___         ___
                    ___         ___         ___         ___         &kp C_VOL_DN    ___         ___         ___         ___         ___
        ___                           _BT_SEL_KEYS_                                 ___         ___         ___         ___         ___         ___
                                            ___         ___         ___             ___         ___
                            >;
